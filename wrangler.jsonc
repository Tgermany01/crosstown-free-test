{
  // Crosstown Community Church: static Astro site (dist/) plus a small Worker for /api/*
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crosstown-community",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-04",
  // Settings are entered in the Cloudflare dashboard (see README). Without this, every deploy would delete the
  // plain-text ones. Secrets are never deleted either way.
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Pages are served straight from the static files; only /api/* runs the Worker.
    "run_worker_first": ["/api/*"],
    // Serve dist/404.html for unknown addresses.
    "not_found_handling": "404-page"
  },
  // Cloudflare Email Service: lets the contact form email the church for free (to a verified address).
  // Needs Email Routing enabled on the domain and the church address verified. See README. If unset or
  // missing, the forms fall back to Resend.
  "send_email": [{ "name": "EMAIL" }],
  // Contacts, form submissions and admin accounts live in a Cloudflare D1 database. With no id given, Wrangler creates
  // it on the first deploy (automatic provisioning) and keeps it linked. The tables are created on first use.
  "d1_databases": [{ "binding": "DB", "database_name": "crosstown-contacts" }],
  "observability": { "enabled": true }
}
