---
import '../styles/global.css';
import { site } from '../data/site';
import { renderHeader, renderFooter, renderNewsletterForm } from '../lib/chrome';

interface Props {
  title?: string;
  description?: string;
  image?: string;
}
const { title, description = site.description, image = '/images/og-image.jpg' } = Astro.props;
const fullTitle = title ? `${title} | ${site.name}` : `${site.name} | ${site.city}, CA`;
const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const canonical = new URL(path, Astro.site);
const ogImage = new URL(image, Astro.site);
const turnstileKey = import.meta.env.PUBLIC_TURNSTILE_SITE_KEY as string | undefined;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: site.name,
  url: Astro.site?.href,
  telephone: site.phone,
  email: site.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: site.street,
    addressLocality: 'Stockton',
    addressRegion: 'CA',
    postalCode: '95205',
    addressCountry: 'US',
  },
  sameAs: [site.facebookUrl, site.youtubeUrl],
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Vollkorn:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {turnstileKey && <script is:inline src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  </head>
  <body>
    <Fragment set:html={renderHeader(site, path)} />
    <main><slot /></main>
    <Fragment set:html={renderFooter(site, path, renderNewsletterForm(turnstileKey))} />
    <script>
      import { initSite } from '../scripts/site';
      initSite();
    </script>
  </body>
</html>
