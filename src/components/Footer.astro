---
import { site } from '../data/site';
import Icon from './Icon.astro';
import NewsletterForm from './NewsletterForm.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="cols">
    <div class="contact">
      <img class="logo" src="/images/logo-white.png" alt="Crosstown" width="130" height="96" loading="lazy" />
      <p class="name">{site.name}</p>
      <ul>
        <li><Icon name="clock" size={18} />{site.hours}</li>
        <li><Icon name="phone" size={18} /><a href={site.phoneHref}>{site.phone}</a></li>
        <li><Icon name="mail" size={18} /><a href={`mailto:${site.email}`}>{site.email}</a></li>
        <li><Icon name="mailbox" size={18} />{site.mailing}</li>
        <li><Icon name="pin" size={18} /><a href={site.mapUrl}>{site.street} {site.cityStateZip}</a></li>
      </ul>
    </div>

    <nav aria-label="Footer">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="fb" href={site.facebookUrl} aria-label="Crosstown on Facebook"><Icon name="facebook" size={34} /></a>
    </nav>

    <div>
      <div class="newsletter">
        <h2>Subscribe to the Crosstown Newsletter</h2>
        <NewsletterForm />
      </div>
      <p class="small">
        ©{year} web design by <a href="https://www.nectarine.ink">Nectarine Studio</a><br />
        Copyright 2023 affiliated with <a href={site.affiliation.url}>{site.affiliation.name}</a>
      </p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: var(--navy); color: var(--white); padding: 56px 16px 72px; font-size: 0.95rem; }
  .cols {
    max-width: 1300px; margin: 0 auto; display: grid; gap: 40px;
    grid-template-columns: 1fr; align-items: start;
  }
  @media (min-width: 900px) { .cols { grid-template-columns: 1.1fr 1fr 1fr; } }
  .logo { width: 150px; margin: 0 0 12px 60px; }
  .name { font-weight: 600; font-size: 1.05rem; padding: 0 0 12px 24px; border-bottom: 1px solid var(--white); max-width: 260px; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 14px; }
  li { display: flex; align-items: center; gap: 10px; }
  li :global(svg) { flex: none; }
  nav { display: grid; justify-items: center; align-content: start; gap: 4px; padding-top: 32px; }
  nav a:not(.fb) { display: block; width: 180px; text-align: center; padding: 6px 0; text-decoration: none; }
  nav a:not(.fb):hover { text-decoration: underline; }
  nav a[aria-current='page'] { background: var(--teal); }
  .fb { margin-top: 6px; }
  .newsletter { border: 1px solid var(--white); padding: 20px 20px 28px; max-width: 300px; }
  .newsletter h2 { font-size: 1.45rem; margin-bottom: 0.6em; }
  .newsletter :global(.field) { color: var(--white); }
  .newsletter :global(input) { background: transparent; border: 1px solid var(--white); border-radius: 8px; color: var(--white); text-align: center; }
  .small { font-size: 0.85rem; margin-top: 24px; }
</style>
