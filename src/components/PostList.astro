---
import type { CollectionEntry } from 'astro:content';
import BlogTabs from './BlogTabs.astro';
import PostCard from './PostCard.astro';
interface Props { posts: CollectionEntry<'posts'>[]; active: string; heading: string }
const { posts, active, heading } = Astro.props;
---
<section class="blog">
  <div class="blog-wrap">
    <h1 class="visually-hidden">{heading}</h1>
    <BlogTabs active={active} />
    <div class="list">
      {posts.map((post) => <PostCard post={post} layout="row" />)}
      {posts.length === 0 && <p>No posts yet.</p>}
    </div>
  </div>
</section>

<style>
  .blog { padding: 72px 0 48px; }
  .blog-wrap { max-width: 940px; margin: 0 auto; padding: 0 16px; }
  .list { display: grid; gap: 32px; margin-top: 40px; }
</style>
