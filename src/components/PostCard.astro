---
import type { CollectionEntry } from 'astro:content';
import { categories } from '../data/site';
interface Props { post: CollectionEntry<'posts'>; layout?: 'stacked' | 'row' }
const { post, layout = 'stacked' } = Astro.props;
const { title, date, author, category, image, description } = post.data;
const fmt = new Intl.DateTimeFormat('en-US', { dateStyle: 'medium', timeZone: 'UTC' });
const words = post.body?.split(/\s+/).length ?? 0;
const minutes = Math.max(1, Math.round(words / 200));
---
<a class:list={['post-card', layout]} href={`/post/${post.id}`}>
  <img class="cover" src={image} alt="" loading="lazy" />
  <div class="body">
    <p class="meta">
      {layout === 'row' && <span class="avatar" aria-hidden="true" />}
      <span>{author}<br />{fmt.format(date)} · {minutes} min read</span>
    </p>
    {layout === 'stacked' && <p class="cat">{categories[category].label}</p>}
    <h3>{title}</h3>
    <p class="excerpt">{description}</p>
  </div>
</a>

<style>
  .post-card { display: grid; background: var(--white); color: var(--navy); text-decoration: none; border: 1px solid #d9d9d9; }
  .post-card:hover h3 { text-decoration: underline; }
  .stacked { max-width: 300px; }
  .stacked img { aspect-ratio: 4 / 3; }
  .row { grid-template-columns: 1fr; }
  .row img { aspect-ratio: 4 / 3; }
  @media (min-width: 720px) { .row { grid-template-columns: 1fr 1fr; } .row { grid-template-columns: 1.2fr 1fr; } .row img { aspect-ratio: auto; min-height: 340px; } .row .body { padding: 28px 32px; } }
  .body { padding: 20px 22px; display: flex; flex-direction: column; }
  .meta { display: flex; gap: 10px; align-items: center; font-size: 0.75rem; line-height: 1.4; margin-bottom: 12px; }
  .avatar { width: 30px; height: 30px; border-radius: 50%; background: #c9c9c9; flex: none; }
  .cat { font-size: 0.8rem; color: var(--blue); margin-bottom: 6px; }
  h3 { font-size: 1.5rem; margin-bottom: 0.5em; }
  .row h3 { font-size: 1.9rem; }
  .excerpt { font-size: 0.9rem; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; }
</style>
