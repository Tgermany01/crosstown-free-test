  play: '<circle cx="12" cy="12" r="10"/><path d="M10 8l6 4-6 4z" fill="currentColor"/>',
  'chevron-down': '<path d="M6 9l6 6 6-6"/>',
  'arrow-left': '<path d="M21 12H3M9 6l-6 6 6 6"/>',
  'arrow-right': '<path d="M3 12h18M15 6l6 6-6 6"/>',
