  dove: '<path d="M3 13c3 0 5-1 7-4 1 3 4 5 8 4l3-3-3-1c-1-3-4-4-6-2-2-3-6-4-9-3 2 2 2 5 4 6-2 1-3 2-4 3z"/><path d="M10 15l-2 4M14 15l1 4"/>',
  pray: '<path d="M12 4v10M12 4c-1 0-2 1-2.5 3L8 13l-3 3 3 4 4-3M12 4c1 0 2 1 2.5 3L16 13l3 3-3 4-4-3"/>',
