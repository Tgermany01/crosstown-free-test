---
import { site } from '../data/site';
import Icon from './Icon.astro';
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<header class="site-header">
  <div class="bar">
    <a class="brand" href="/" aria-label={`${site.name} home`}>
      <img src="/images/logo-white.png" alt="Crosstown" width="120" height="88" />
    </a>
    <button class="toggle" aria-expanded="false" aria-controls="main-nav">
      <Icon name="menu" size={28} /><span class="visually-hidden">Menu</span>
    </button>
    <nav id="main-nav" aria-label="Main">
      {site.nav.map((item) => (
        <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>{item.label}</a>
      ))}
      <a class="btn btn-orange" href={site.donateUrl}>Donate</a>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--navy); color: var(--white); position: relative; z-index: 10; }
  .bar {
    max-width: 1300px; margin: 0 auto; padding: 0 16px; min-height: 176px;
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
  }
  .brand img { width: 122px; height: auto; }
  nav { display: flex; align-items: center; gap: 28px; }
  nav a:not(.btn) {
    font-family: var(--heading); font-style: italic; font-size: 1.2rem;
    color: var(--white); text-decoration: none;
  }
  nav a:not(.btn):hover, nav a[aria-current='page'] { text-decoration: underline; text-underline-offset: 4px; }
  nav .btn { padding: 0.75em 2.6em; font-weight: 400; }
  .toggle { display: none; background: none; border: 0; color: var(--white); cursor: pointer; padding: 8px; }

  @media (max-width: 900px) {
    .bar { min-height: 84px; }
    .brand img { width: 90px; }
    .toggle { display: block; }
    nav {
      display: none; position: absolute; top: 100%; left: 0; right: 0;
      flex-direction: column; align-items: flex-start; gap: 18px;
      background: var(--navy); padding: 20px 16px 28px; border-top: 1px solid rgba(255, 255, 255, 0.15);
    }
    nav.open { display: flex; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.site-header .toggle');
  const nav = document.getElementById('main-nav');
  toggle?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open') ?? false;
    toggle.setAttribute('aria-expanded', String(open));
  });
</script>
