---
import Base from '../layouts/Base.astro';
import PostList from '../components/PostList.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
---
<Base title="Blog" description="Testimonies and outreach reports from Crosstown Community Church.">
  <PostList posts={posts} active="all" heading="Blog" />
</Base>
