---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import { site } from '../data/site';
import { img } from '../data/images';

const resources = [
  { title: 'Live at 5', text: 'A short midweek broadcast with scripture and prayer.', href: '#liveat5' },
  { title: 'Contact & Locate', text: `${site.street}, ${site.cityStateZip}`, href: '#contact' },
  { title: "This Week's Service", text: 'Watch the latest Sunday message.', href: '#thisweekssermon' },
  { title: "God's Feeding Hands", text: 'Our monthly outreach to the homeless community.', href: '/outreach' },
  { title: 'Past Sermons', text: 'The full sermon playlist on YouTube.', href: site.pastSermonsUrl },
  { title: 'Victims of Violent Crimes', text: 'Support for families affected by violent crime.', href: 'https://www.victimsofviolentcrimes.org/' },
];
---
<Base>
  <section class="hero">
    <img src={img('hero')} alt="The Crosstown church family gathered together" fetchpriority="high" />
    <div class="wrap">
      <p class="eyebrow" style="color:#fff">Welcome to</p>
      <h1>{site.name} of {site.city}</h1>
      <p>Sunday Service at 11 a.m. · Bible Study Wednesdays at 2 &amp; 6:30 p.m.</p>
      <p><strong>{site.tagline}</strong></p>
      <div class="btn-row">
        <a class="btn" href="#contact">Plan a visit</a>
        <a class="btn ghost" style="color:#fff;border-color:#fff" href={site.donateUrl}>Donate</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2>Resources</h2>
      <div class="cards">
        {resources.map((r) => (
          <a class="card" href={r.href} style="text-decoration:none;color:inherit">
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid-2">
      <img class="rounded" src={img('kitchen')} alt="Pastor Kevin and Paula White in the church kitchen" loading="lazy" />
      <div>
        <p class="eyebrow">About us</p>
        <h2>Every person matters to God</h2>
        <p>Our mission is to make disciples through worship, growth and service.</p>
        <a class="btn" href="/about">Learn More</a>
      </div>
    </div>
  </section>

  <section class="section" id="thisweekssermon">
    <div class="wrap">
      <p class="eyebrow">This week's sermon</p>
      <h2>{site.sermon.title}</h2>
      <div style="aspect-ratio:16/9;max-width:860px">
        <iframe
          src={`https://www.youtube-nocookie.com/embed/${site.sermon.youtubeId}`}
          title={site.sermon.title}
          loading="lazy"
          style="width:100%;height:100%;border:0;border-radius:var(--radius)"
          allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
          allowfullscreen></iframe>
      </div>
      <div class="btn-row"><a class="btn ghost" href={site.pastSermonsUrl}>All Videos</a></div>
    </div>
  </section>

  <section class="section alt">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Sunday gatherings</p>
        <h2>Join us Sundays at 11 a.m.</h2>
        <p>Our worship services include song, prayer and a message. Near the close there's an invitation to prayer, followed by time for fellowship.</p>
      </div>
      <div>
        <h3>Watch past gatherings</h3>
        <div class="btn-row">
          <a class="btn" href={site.facebookUrl}>Watch on Facebook Live</a>
          <a class="btn ghost" href={site.youtubeUrl}>Watch on YouTube</a>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="liveat5">
    <div class="wrap grid-2">
      <div>
        <p class="eyebrow">Live at 5</p>
        <h2>Wednesdays, 5:00 to 5:15 p.m.</h2>
        <p>A short weekly broadcast on Facebook Live with a scripture for the day and prayer.</p>
        <p>
          Send prayer requests by text to <a href={site.phoneHref}>{site.phone}</a> or email
          <a href={`mailto:${site.email}?subject=Prayer%20Request`}>{site.email}</a> before 4 p.m. Wednesday.
        </p>
        <a class="btn" href={site.liveAt5Url}>Watch Live @ 5 Now</a>
      </div>
      <img class="rounded" src={img('bibleStudy')} alt="Bible study at Crosstown" loading="lazy" />
    </div>
  </section>

  <section class="section alt" id="contact">
    <div class="wrap grid-2" style="align-items:start">
      <div>
        <h2>Get in touch</h2>
        <p><a href={site.mapUrl}>{site.street}<br />{site.cityStateZip}</a></p>
        <p><a href={site.phoneHref}>{site.phone}</a><br /><a href={`mailto:${site.email}`}>{site.email}</a></p>
        <iframe
          title="Map to Crosstown Community Church"
          src="https://maps.google.com/maps?q=924%20North%20Filbert%20Street%2C%20Stockton%2C%20CA%2095205&output=embed"
          loading="lazy"
          style="width:100%;aspect-ratio:4/3;border:0;border-radius:var(--radius)"></iframe>
      </div>
      <ContactForm />
    </div>
  </section>
</Base>
