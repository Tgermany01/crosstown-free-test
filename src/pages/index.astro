---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import Wave from '../components/Wave.astro';
import { site } from '../data/site';

const resources = [
  { icon: 'broadcast', title: 'Live at 5', text: "See this week's episode of Live at 5 with Pastor Kevin.", href: '#liveat5' },
  { icon: 'church', title: "This Week's Service", text: "Click here to watch this Sunday's Service.", href: '#thisweekssermon' },
  { icon: 'camera', title: 'Past Sermons', text: 'Click here to select from and watch past services.', href: site.pastSermonsUrl },
  { icon: 'book', title: 'Bible Study Resources', text: 'Browse book recommendations & Bible study resources.', href: '/blog' },
  { icon: 'pin', title: 'Contact & Locate', text: 'Find our church, request prayer, connect with us.', href: '#contact' },
  { icon: 'hands', title: "God's Feeding Hands", text: 'Get information about our homeless outreach ministry.', href: '/outreach#feeding-hands' },
  { icon: 'dove', title: 'Victims of Violent Crimes', text: 'Learn more about VOVC support groups & resources.', href: site.vovcUrl },
];
const thumb = `https://i.ytimg.com/vi/${site.sermon.youtubeId}/maxresdefault.jpg`;
---
<Base>
  <section class="hero">
    <img class="cover" src="/images/hero.jpg" alt="" fetchpriority="high" />
    <div class="hero-inner">
      <p class="welcome">Welcome to</p>
      <h1 class="visually-hidden">{site.name}</h1>
      <img class="hero-logo" src="/images/logo-navy.png" alt="Crosstown" width="420" height="310" />
      <p class="hero-lines">
        <strong>Crosstown Community Church of Stockton</strong><br />
        <strong>Sunday Service at 11 a.m. | Bible Study on Wednesdays at 2 &amp; 6:30 p.m.</strong><br />
        <em>{site.tagline}</em>
      </p>
    </div>
  </section>

  <section class="section resources">
    <div class="wrap wide res-grid">
      <h2 class="dot-heading">Resources</h2>
      <div class="cards">
        {resources.map((r) => (
          <a class="card" href={r.href}>
            <Icon name={r.icon} size={40} />
            <h3>{r.title}</h3>
            <p>{r.text}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="photo-band">
    <Wave top="#ffffff" bottom="transparent" />
  </div>

  <section class="bg-teal anthem">
    <div class="narrow">
      <p>"If Crosstown had an anthem, it would be the song that begins, ‘Everyone needs compassion; A love that’s never failing, let mercy fall on me; Everyone needs forgiveness, the kindness of a Savior, the Hope of nations."</p>
    </div>
  </section>
  <Wave top="#045174" bottom="#001f3d" />

  <section class="bg-navy section">
    <div class="wrap wide about">
      <img class="rounded" src="/images/kevin-and-paula.jpg" alt="Pastor Kevin and Paula White" loading="lazy" width="720" height="795" />
      <div>
        <h2 class="h1">About</h2>
        <p>{site.mission}</p>
        <a class="btn btn-orange" href="/about">Learn More</a>
      </div>
    </div>
  </section>

  <section class="sermon" id="thisweekssermon">
    <img class="cover" src={thumb} alt="" loading="lazy" />
    <div class="sermon-inner">
      <p>Crosstown Stockton</p>
      <h2>{site.sermon.title}</h2>
      <button class="play" type="button" data-video={site.sermon.youtubeId}>
        <Icon name="play" size={30} /> <span>Play Video</span>
      </button>
      <a class="btn btn-outline all-videos" href={site.pastSermonsUrl}>All Videos <Icon name="plus" size={16} /></a>
    </div>
  </section>

  <section class="bg-navy section gatherings">
    <div class="narrow">
      <div class="icon-row">
        <span class="badge"><span class="tri up"></span></span>
        <div>
          <h2>Sunday Gatherings</h2>
          <p>We gather for Worship Services every Sunday from 11 am to 12:30 pm, consisting of worship through song and prayer and a message. Invitations are also given for those who are in need of personal prayer near the close of each service. Those in attendance are encouraged to hang out after the service to meet with one another, pray and generally catch up with one another.</p>
          <h3>Watch Past Gatherings</h3>
          <p>To see past Sunday gatherings and sermons, you can click above to visit our YouTube Sunday Gathering playlist. You can also find the full version of our gatherings on our <strong>Facebook</strong> channel, Crosstown Community Church of Stockton.</p>
          <p class="small-links"><a href={site.facebookUrl}>Watch on Facebook Live</a> | <a href={site.youtubeUrl}>Watch on Youtube</a></p>
        </div>
      </div>
    </div>
  </section>

  <section class="bg-teal section" id="liveat5">
    <div class="narrow">
      <div class="icon-row">
        <span class="badge"><span class="tri down"></span></span>
        <div>
          <h2>Live at 5</h2>
          <p>We have a 5-minute weekly broadcast on Wednesdays at 5:00-5:15 pm on Crosstown's Facebook Live including a scripture for the day and a time of prayer together. Send your prayer requests by text to {site.textNumber} or e-mail: <a href={`mailto:${site.email}?subject=Prayer%20Request`}>{site.email}</a> any day &amp; time before 4pm Wednesday to be included in that day’s prayer time.</p>
          <a class="btn btn-orange" href={site.liveAt5Url}>Watch Live @ 5 Now</a>
        </div>
      </div>
    </div>
  </section>

  <ContactForm />
</Base>

<style>
  .hero { position: relative; display: grid; place-items: center; min-height: clamp(530px, 59vw, 850px); text-align: center; }
  .hero > .cover { position: absolute; inset: 0; }
  .hero::after { content: ''; position: absolute; inset: 0; background: rgba(255, 255, 255, 0.82); }
  .hero-inner { position: relative; z-index: 1; padding: 64px 16px; }
  .welcome { font-family: var(--body); font-weight: 600; font-size: clamp(1.6rem, 3vw, 2.4rem); margin: 0 0 -12px; transform: translateX(-12%); }
  .hero-logo { width: min(470px, 80vw); margin: 0 auto 32px; }
  .hero-lines { font-size: clamp(1rem, 1.6vw, 1.3rem); line-height: 1.5; }
  .hero-lines strong { font-weight: 600; }

  .res-grid { display: grid; gap: 32px; grid-template-columns: 1fr; }
  @media (min-width: 900px) { .res-grid { grid-template-columns: 240px 1fr; align-items: start; } .resources h2 { margin-top: 12px; } }
  .resources h2 { color: var(--teal); font-size: 2.1rem; }
  .cards { display: grid; gap: 12px; grid-template-columns: repeat(auto-fill, minmax(190px, 1fr)); }
  @media (min-width: 1100px) { .cards { grid-template-columns: repeat(4, 226px); } .card { min-height: 220px; align-content: start; padding-top: 28px; } }
  .card {
    background: var(--ice); color: var(--teal); text-decoration: none; text-align: center;
    border-radius: 8px; padding: 20px 18px; display: grid; justify-items: center; gap: 6px;
    transition: transform 0.2s, box-shadow 0.2s;
  }
  .card:hover { transform: translateY(-3px); box-shadow: 0 6px 16px rgba(0, 31, 61, 0.12); }
  .card h3 { font-family: var(--body); font-style: normal; font-weight: 600; font-size: 0.95rem; color: var(--navy); margin: 8px 0 4px; }
  .card p { font-size: 0.85rem; line-height: 1.6; margin: 0; }

  .photo-band {
    height: clamp(90px, 12vw, 160px);
    background: linear-gradient(rgba(4, 81, 116, 0.55), rgba(4, 81, 116, 0.85)), url('/images/bible-study.jpg') center 60% / cover;
  }
  .anthem { padding: clamp(48px, 7vw, 110px) 0 clamp(96px, 11vw, 160px); text-align: center; }
  .anthem p { font-family: var(--heading); font-style: italic; font-size: clamp(1.3rem, 2.3vw, 1.75rem); line-height: 1.45; }

  .about { display: grid; gap: 48px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .about { grid-template-columns: 1fr 1fr; } .about { grid-template-columns: 1.25fr 1fr; } .about > div { padding-left: 15%; } }
  .about img { width: 100%; max-height: 500px; object-fit: cover; }

  .sermon { position: relative; color: var(--white); text-align: center; min-height: clamp(460px, 42vw, 600px); display: grid; place-items: center; overflow: hidden; background: #2b2b2b; }
  .sermon > .cover { position: absolute; inset: 0; }
  .sermon::after { content: ''; position: absolute; inset: 0; background: rgba(0, 0, 0, 0.45); }
  .sermon-inner { position: relative; z-index: 1; padding: 64px 16px; display: grid; justify-items: center; gap: 8px; }
  .sermon h2 { font-style: normal; font-size: clamp(2rem, 4vw, 3.2rem); margin: 0; }
  .play { display: inline-flex; align-items: center; gap: 10px; background: none; border: 0; color: inherit; font: inherit; cursor: pointer; }
  .play span { text-decoration: underline; }
  .all-videos { margin-top: 56px; display: inline-flex; align-items: center; gap: 10px; font-weight: 400; }
  .sermon iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; z-index: 2; }

  .icon-row { display: grid; grid-template-columns: 48px 1fr; gap: 20px; }
  .badge { width: 48px; height: 48px; border-radius: 50%; background: var(--white); display: grid; place-items: center; margin-top: 6px; }
  .tri { width: 0; height: 0; border-left: 11px solid transparent; border-right: 11px solid transparent; }
  .tri.up { border-bottom: 14px solid var(--navy); margin-top: -3px; }
  .tri.down { border-top: 14px solid var(--teal); margin-top: 3px; }
  .gatherings h3 { margin-top: 1.2em; }
  .small-links { font-size: 0.9rem; }
  .gatherings p, #liveat5 p { font-size: 0.95rem; }
</style>

<script>
  // "Play Video" swaps the thumbnail for the YouTube player.
  const play = document.querySelector<HTMLButtonElement>('.sermon .play');
  play?.addEventListener('click', () => {
    const frame = document.createElement('iframe');
    frame.src = `https://www.youtube-nocookie.com/embed/${play.dataset.video}?autoplay=1`;
    frame.allow = 'autoplay; encrypted-media; picture-in-picture';
    frame.allowFullscreen = true;
    frame.title = 'This week\'s sermon';
    play.closest('.sermon')?.append(frame);
  });
</script>
