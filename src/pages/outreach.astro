---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import Wave from '../components/Wave.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { Content as Csi } from '../copy/outreach-csi.md';
import { Content as Feeding } from '../copy/outreach-feeding-hands.md';

const posts = (await getCollection('posts')).sort((a, b) => +b.data.date - +a.data.date);
const csiPosts = posts.filter((p) => p.data.category === 'csi');
const feedingPosts = posts.filter((p) => p.data.category === 'feeding-hands');
const gallery = [
  '/images/feeding-hands-1.jpg',
  '/images/outreach-hero.jpg',
  '/images/feeding-hands-2.jpg',
  '/images/feeding-hands-3.jpg',
  '/images/feeding-hands-4.jpg',
];
---
<Base title="Community Outreach" description="Crime Scene Intercessors and God's Feeding Hands: how Crosstown Community Church serves Stockton.">
  <section class="bg-navy hero">
    <div class="wrap hero-grid">
      <div class="hero-text">
        <h1>Community Outreach</h1>
        <p>"But you are a chosen race, a royal priesthood, a holy nation, a people for his own possession, that you may proclaim the excellencies of him who called you out of darkness into his marvelous light"<br />- 1 Peter 2:9</p>
      </div>
      <div class="collage">
        <img class="rounded small" src="/images/outreach-hero.jpg" alt="Crosstown volunteers at a homeless encampment" />
        <img class="rounded big" src="/images/csi.jpg" alt="An open Bible at a prayer vigil" />
      </div>
    </div>
  </section>
  <Wave top="#001f3d" bottom="#ffffff" />

  <section class="section" id="csi">
    <div class="wrap csi-grid">
      <div>
        <h2 class="dot-heading teal">Crime Scene Intercessors</h2>
        <div class="indent teal-text"><Csi /></div>
      </div>
      <div class="join">
        <Icon name="fingerprint" size={64} class="fp" />
        <NewsletterForm list="csi" button="Join the CSI Team" success="Thanks! We'll add you to the CSI group texts." buttonClass="btn btn-teal" />
      </div>
    </div>
    <div class="wrap testimonies">
      <h2 class="teal">Testimonies from CSI</h2>
      <div class="post-row">{csiPosts.map((post) => <PostCard post={post} />)}</div>
    </div>
  </section>

  <Wave top="#ffffff" bottom="#001f3d" flip />
  <section class="bg-navy section" id="feeding-hands">
    <div class="wrap gfh-grid">
      <div>
        <h2 class="dot-heading">God's Feeding Hands</h2>
        <div class="indent body"><Feeding /></div>
      </div>
      <div class="gallery">
        <img class="main" src={gallery[0]} alt="God's Feeding Hands volunteers" loading="lazy" />
        <div class="thumbs">
          {gallery.map((src, i) => (
            <button type="button" aria-label={`Show photo ${i + 1}`} aria-pressed={i === 0 ? 'true' : 'false'} data-src={src}>
              <img src={src} alt="" loading="lazy" />
            </button>
          ))}
        </div>
      </div>
    </div>
    <div class="wrap testimonies">
      <h2>Testimonies from God's Feeding Hands</h2>
      <div class="post-row">{feedingPosts.map((post) => <PostCard post={post} />)}</div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: 40px 0 72px; }
  .hero-grid { display: grid; gap: 40px; align-items: center; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .hero-grid { grid-template-columns: 1fr 1.2fr; } }
  .hero-text { text-align: center; max-width: 360px; margin: 0 auto; }
  .hero-text h1 { font-size: clamp(2.4rem, 4vw, 3.2rem); }
  .hero-text p { font-size: 0.9rem; }
  .collage { position: relative; min-height: clamp(360px, 42vw, 600px); }
  .collage img { position: absolute; object-fit: cover; }
  .collage .small { width: 40%; height: 40%; right: 4%; top: 0; }
  .collage .big { width: 66%; height: 72%; left: 0; bottom: 0; }

  .teal { color: var(--teal); }
  .teal-text { color: var(--teal); font-size: 0.95rem; }
  .csi-grid { display: grid; gap: 40px; align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .csi-grid { grid-template-columns: 1.4fr 1fr; } }
  .join { background: var(--ice); border-radius: 32px; padding: 24px 24px 12px; max-width: 320px; display: grid; justify-items: center; }
  .join :global(.fp) { color: var(--blue); }
  .join :global(form) { width: 100%; }
  .join :global(input) { border: 1px solid var(--blue); text-align: center; }
  .join :global(.btn) { font-weight: 400; }

  .testimonies { margin-top: 64px; }
  .testimonies h2 { font-size: clamp(1.6rem, 2.6vw, 2.1rem); }
  .post-row { display: flex; flex-wrap: wrap; gap: 20px; margin-top: 24px; }

  .gfh-grid { display: grid; gap: 40px; align-items: start; grid-template-columns: 1fr; }
  @media (min-width: 860px) { .gfh-grid { grid-template-columns: 1fr 1.3fr; } }
  .body { font-size: 0.9rem; line-height: 1.75; }
  .gallery .main { width: 100%; aspect-ratio: 4 / 3; object-fit: cover; }
  .thumbs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; margin-top: 10px; }
  .thumbs button { padding: 0; border: 0; background: none; cursor: pointer; opacity: 0.6; }
  .thumbs button[aria-pressed='true'], .thumbs button:hover { opacity: 1; }
  .thumbs img { aspect-ratio: 1; object-fit: cover; width: 100%; }
</style>

<script>
  const main = document.querySelector<HTMLImageElement>('.gallery .main');
  const buttons = document.querySelectorAll<HTMLButtonElement>('.thumbs button');
  buttons.forEach((b) =>
    b.addEventListener('click', () => {
      if (main && b.dataset.src) main.src = b.dataset.src;
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
    }),
  );
</script>
