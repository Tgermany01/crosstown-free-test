---
import Base from '../../../layouts/Base.astro';
import { site } from '../../../data/site';
import { renderSections } from '../../../lib/blocks';
import { loadPosts } from '../../../lib/posts';

export function getStaticPaths() {
  return site.categories.map((c) => ({ params: { slug: c.slug }, props: { cat: c } }));
}
const { cat } = Astro.props;
const posts = await loadPosts();
const html = renderSections(
  [{ type: 'post-feed', heading: cat.label, category: cat.key, layout: 'rows', tabs: true, limit: '0', bg: 'white' }],
  { site, posts },
);
---
<Base title={cat.label} description={`${cat.label} posts from Crosstown Community Church.`}>
  <Fragment set:html={html} />
</Base>
