---
import '../../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Preview</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Lora:ital,wght@0,400;0,600;0,700;1,400&family=Vollkorn:ital,wght@0,400;0,600;0,700;1,400&display=swap" rel="stylesheet" />
  </head>
  <body>
    <div id="root"></div>
    <script>
      import '../../admin/preview';
    </script>
    <style is:global>
      [data-sid] { cursor: pointer; }
      [data-sid]:hover { outline: 3px solid rgba(250, 152, 47, 0.55); outline-offset: -3px; }
      [data-sid].is-selected { outline: 3px solid #fa982f; outline-offset: -3px; }
    </style>
  </body>
</html>
