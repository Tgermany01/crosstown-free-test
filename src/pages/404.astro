---
import Base from '../layouts/Base.astro';
---
<Base title="Page not found">
  <section class="nf">
    <h1>Page not found</h1>
    <p>That page may have moved when we updated our website.</p>
    <a class="btn btn-orange" href="/">Go to the homepage</a>
  </section>
</Base>

<style>
  .nf { text-align: center; min-height: 50vh; display: grid; place-content: center; justify-items: center; padding: 64px 16px; }
</style>
