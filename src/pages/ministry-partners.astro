---
import Base from '../layouts/Base.astro';
import ContactForm from '../components/ContactForm.astro';
import Icon from '../components/Icon.astro';
import { partners } from '../data/site';
---
<Base title="Ministry Partners" description="The local organizations Crosstown Community Church partners with in Stockton, CA.">
  <section class="split intro">
    <img class="cover" src="/images/ministry-partners.jpg" alt="Crosstown members with the Stockton Police Chaplaincy" fetchpriority="high" />
    <div class="intro-text">
      <h1>Ministry Partners</h1>
      <p>We're grateful to partner with fellow believers and local partners in Stockton, CA, all under the guiding light of our faith in Jesus. Through this united effort, we're committed to making a lasting impact on our city. Join us as we let our faith inspire acts of compassion, community, and positive change. Together, with Jesus as our cornerstone, we're praying &amp; believing for a brighter future for Stockton.</p>
    </div>
  </section>

  <section class="section carousel" aria-roledescription="carousel" aria-label="Ministry partners">
    <button class="arrow prev" type="button" aria-label="Previous partner"><Icon name="arrow-left" size={80} /></button>
    <div class="slides">
      {partners.map((p, i) => (
        <article class="slide" aria-roledescription="slide" aria-label={`${i + 1} of ${partners.length}`} hidden={i !== 0}>
          <span class="partner-icon"><Icon name={p.icon} size={72} /></span>
          <h2>{p.name}</h2>
          <p>{p.text}</p>
          {p.url && <a class="btn btn-orange" href={p.url}>Visit their website</a>}
        </article>
      ))}
    </div>
    <button class="arrow next" type="button" aria-label="Next partner"><Icon name="arrow-right" size={80} /></button>
    <div class="dots">
      {partners.map((p, i) => (
        <button type="button" aria-label={`Show ${p.name}`} aria-current={i === 0 ? 'true' : undefined} data-i={i}></button>
      ))}
    </div>
  </section>

  <ContactForm subject="Ministry partners" />
</Base>

<style>
  .intro { min-height: clamp(460px, 45vw, 650px); }
  .intro > img { max-height: 650px; }
  .intro-text { display: grid; place-content: center; text-align: center; padding: 56px 16px; }
  .intro-text p { max-width: 360px; margin: 0 auto; font-size: 0.95rem; }

  .carousel { position: relative; display: grid; grid-template-columns: auto 1fr auto; align-items: center; gap: 16px; max-width: 1300px; margin: 0 auto; padding-left: 16px; padding-right: 16px; }
  .slide { text-align: center; color: var(--teal); max-width: 800px; margin: 0 auto; }
  .slide h2 { margin: 12px 0 0.6em; font-size: clamp(2rem, 3.2vw, 2.6rem); }
  .slide p { font-size: 1rem; margin-bottom: 2em; }
  .slide .btn { font-weight: 400; color: var(--white); padding: 0.55em 2.6em; }
  .partner-icon { width: 140px; height: 140px; border-radius: 50%; background: var(--mist); color: var(--white); display: inline-grid; place-items: center; }
  .arrow { background: none; border: 0; color: var(--mid-blue); cursor: pointer; padding: 8px; }
  .dots { grid-column: 1 / -1; display: flex; justify-content: center; gap: 10px; margin-top: 32px; }
  .dots button { width: 7px; height: 7px; border-radius: 50%; border: 1px solid var(--teal); background: var(--teal); padding: 0; cursor: pointer; }
  .dots button[aria-current='true'] { width: 9px; height: 9px; background: transparent; }
  @media (max-width: 600px) { .arrow :global(svg) { width: 28px; } }
</style>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>('.carousel .slide')];
  const dots = [...document.querySelectorAll<HTMLButtonElement>('.carousel .dots button')];
  let current = 0;
  function show(i: number) {
    current = (i + slides.length) % slides.length;
    slides.forEach((s, j) => (s.hidden = j !== current));
    dots.forEach((d, j) => (j === current ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
  }
  document.querySelector('.carousel .prev')?.addEventListener('click', () => show(current - 1));
  document.querySelector('.carousel .next')?.addEventListener('click', () => show(current + 1));
  dots.forEach((d, j) => d.addEventListener('click', () => show(j)));
</script>
